module game_fsm (
    input logic         clk,
    input logic         reset,

    input logic         map_rst,
    input logic         reload_done,
    input logic [1:0]   lives,

    output logic [1:0]  game_state
)

    typedef enum logic [1:0] {
        STARTING = 2'd0,
        PLAYING  = 2'd1,
        OVER     = 2'd2
    } state_t

    state_t state, next_state;

    assign game_state = state;

    always_ff @(posedge clk or posedge reset) begin
        if(reset) begin
            game_state <= STARTING;
        end else begin
            state <= next_state;
        end
    end

    always_comb begin
        if(map_rst) begin
            next_state = STARTING;
        end else begin
            case(state)
                STARTING: begin
                    if(reload_done) begin
                        next_state = PLAYING;
                    end else begin
                        next_state = STARTING;
                    end
                end

                PLAYING: begin
                    if(lives == 2'd0) begin
                        next_state = OVER;
                    end else begin
                        next_state = PLAYING;
                    end
                end

                OVER: begin
                    if(map_rst) begin
                        next_state = STARTING;
                    end else begin
                        next_state = OVER;
                    end
                end

                default: begin
                    next_state = STARTING;
            endcase
        end
    end
endmodule

